# SSH-ключи от арендованных ВМ. Приватный ключ в публичном репозитории —
# это компрометация: GitHub индексируется, а из истории он уже не вычищается
# простым удалением файла.
immers/
*.pem
*.key

# Отладочные прогоны: смоуки и dev-итерации по промптам на train.
# В репозитории нужны только результаты рук по eval, синтетика и holdout.
results/*_smoke.jsonl
results/*_smoke.meta.json
results/*_dev.jsonl
results/*_dev.meta.json
__pycache__/
