# Производные файлы датасета: полностью пересобираются из train.jsonl/eval.jsonl
# командами `to_unsloth.py` и `finetune_client.py`. В гите это ~10 МБ дублей,
# основную долю которых занимает system-промпт, повторённый в каждой строке.
datasets/prepared/

# SSH-ключи от арендованных ВМ. Приватный ключ в публичном репозитории —
# это компрометация: GitHub индексируется, а из истории он уже не вычищается
# простым удалением файла.
immers/
*.pem
*.key
