{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(python3 -m py_compile *)",
      "Bash(python3 -m pytest *)",
      "Bash(python3 ./webui/app.py)",
      "Bash(curl http://127.0.0.1:5000*)",
      "Bash(curl http://localhost:5000*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(.env)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.sh\""
          }
        ]
      }
    ]
  }
}
