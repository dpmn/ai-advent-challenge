 // Package api — HTTP-слой сервиса: маршруты, разбор запросов, JSON-ответы.    
                                                                                
 package api                                                                    
                                                                                
                                                                                
                                                                                
 import (                                                                       
                                                                                
     "encoding/json"                                                            
                                                                                
     "errors"                                                                   
                                                                                
     "io/fs"                                                                    
                                                                                
     "log"                                                                      
                                                                                
     "net/http"                                                                 
                                                                                
     "strings"                                                                  
                                                                                
     "time"                                                                     
                                                                                
                                                                                
                                                                                
     "fridge-chef/internal/corpus"                                              
                                                                                
     "fridge-chef/internal/generate"                                            
                                                                                
     "fridge-chef/internal/match"                                               
                                                                                
 )                                                                              
                                                                                
                                                                                
                                                                                
 // Server держит зависимости хендлеров: корпус и LLM.                          
                                                                                
 type Server struct {                                                           
                                                                                
     corpus  *corpus.Corpus                                                     
                                                                                
     chatter generate.Chatter                                                   
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 // New регистрирует маршруты API и статику UI на mux.                          
                                                                                
 func New(mux *http.ServeMux, c *corpus.Corpus, ch generate.Chatter, static     
 fs.FS) *Server {                                                               
                                                                                
     s := &Server{corpus: c, chatter: ch}                                       
                                                                                
     mux.HandleFunc("GET /healthz", s.handleHealthz)                            
                                                                                
     mux.HandleFunc("GET /api/v1/corpus", s.handleCorpus)                       
                                                                                
     mux.HandleFunc("POST /api/v1/suggest", s.handleSuggest)                    
                                                                                
     mux.HandleFunc("POST /api/v1/recipe", s.handleRecipe)                      
                                                                                
     mux.HandleFunc("POST /api/v1/feedback", s.handleFeedback) // Новый         
 эндпоинт                                                                       
                                                                                
     mux.Handle("GET /", http.FileServerFS(static))                             
                                                                                
     return s                                                                   
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 // handleHealthz — проверка живости сервиса.                                   
                                                                                
 func (s *Server) handleHealthz(w http.ResponseWriter, _ *http.Request) {       
                                                                                
     writeJSON(w, http.StatusOK, map[string]string{"status": "ok"})             
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 // handleCorpus отдаёт манифест активной версии корпуса.                       
                                                                                
 func (s *Server) handleCorpus(w http.ResponseWriter, _ *http.Request) {        
                                                                                
     writeJSON(w, http.StatusOK, s.corpus.Manifest())                           
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 type suggestRequest struct {                                                   
                                                                                
     Products []string `json:"products"`                                        
                                                                                
     Limit    int      `json:"limit"`                                           
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 type candidateDTO struct {                                                     
                                                                                
     ID       string   `json:"id"`                                              
                                                                                
     Title    string   `json:"title"`                                           
                                                                                
     URL      string   `json:"url"`                                             
                                                                                
     Coverage float64  `json:"coverage"`                                        
                                                                                
     Matched  int      `json:"matched"`                                         
                                                                                
     Required int      `json:"required"`                                        
                                                                                
     Missing  []string `json:"missing"`                                         
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 type suggestResponse struct {                                                  
                                                                                
     Products   []string       `json:"products"`                                
                                                                                
     Candidates []candidateDTO `json:"candidates"`                              
                                                                                
     Message    string         `json:"message,omitempty"`                       
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 // handleSuggest подбирает рецепты-кандидаты по списку продуктов.              
                                                                                
 func (s *Server) handleSuggest(w http.ResponseWriter, r *http.Request) {       
                                                                                
     var req suggestRequest                                                     
                                                                                
     if !decode(w, r, &req) {                                                   
                                                                                
         return                                                                 
                                                                                
     }                                                                          
                                                                                
     products := normalize(s.corpus, req.Products)                              
                                                                                
     if len(products) == 0 {                                                    
                                                                                
         writeError(w, http.StatusBadRequest, "укажи хотя бы один продукт")     
                                                                                
         return                                                                 
                                                                                
     }                                                                          
                                                                                
     if req.Limit > 50 {                                                        
                                                                                
         req.Limit = 50                                                         
                                                                                
     }                                                                          
                                                                                
                                                                                
                                                                                
     cands := match.Suggest(s.corpus.Recipes(), products, req.Limit)            
                                                                                
     resp := suggestResponse{Products: products, Candidates:                    
 make([]candidateDTO, 0, len(cands))}                                           
                                                                                
     for _, c := range cands {                                                  
                                                                                
         if c.Missing == nil {                                                  
                                                                                
             c.Missing = []string{}                                             
                                                                                
         }                                                                      
                                                                                
         resp.Candidates = append(resp.Candidates, candidateDTO{                
                                                                                
             ID:       c.Recipe.ID,                                             
                                                                                
             Title:    c.Recipe.Title,                                          
                                                                                
             URL:      c.Recipe.Source.URL,                                     
                                                                                
             Coverage: c.Coverage,                                              
                                                                                
             Matched:  c.Matched,                                               
                                                                                
             Required: c.Required,                                              
                                                                                
             Missing:  c.Missing,                                               
                                                                                
         })                                                                     
                                                                                
     }                                                                          
                                                                                
     if len(cands) == 0 {                                                       
                                                                                
         resp.Message = "Подходящего рецепта не нашёл. Могу придумать блюдо из  
 твоих продуктов (режим creative)."                                             
                                                                                
     }                                                                          
                                                                                
     writeJSON(w, http.StatusOK, resp)                                          
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 type recipeRequest struct {                                                    
                                                                                
     RecipeID string   `json:"recipe_id"`                                       
                                                                                
     Products []string `json:"products"`                                        
                                                                                
     Mode     string   `json:"mode"`                                            
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 type recipeResponse struct {                                                   
                                                                                
     Mode     string         `json:"mode"`                                      
                                                                                
     Invented bool           `json:"invented"`                                  
                                                                                
     Title    string         `json:"title,omitempty"`                           
                                                                                
     Source   *corpus.Source `json:"source,omitempty"`                          
                                                                                
     Text     string         `json:"text"`                                      
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 // handleRecipe отдаёт полный рецепт: strict — из корпуса без LLM,             
                                                                                
 // combine — LLM-адаптация под продукты, creative — LLM-импровизация без       
 рецепта-основы.                                                                
                                                                                
 func (s *Server) handleRecipe(w http.ResponseWriter, r *http.Request) {        
                                                                                
     var req recipeRequest                                                      
                                                                                
     if !decode(w, r, &req) {                                                   
                                                                                
         return                                                                 
                                                                                
     }                                                                          
                                                                                
     mode := req.Mode                                                           
                                                                                
     if mode == "" {                                                            
                                                                                
         mode = "combine"                                                       
                                                                                
     }                                                                          
                                                                                
     products := normalize(s.corpus, req.Products)                              
                                                                                
                                                                                
                                                                                
     switch mode {                                                              
                                                                                
     case "creative":                                                           
                                                                                
         if len(products) == 0 {                                                
                                                                                
             writeError(w, http.StatusBadRequest, "для creative нужны           
 продукты")                                                                     
                                                                                
             return                                                             
                                                                                
         }                                                                      
                                                                                
         text, err := generate.Creative(r.Context(), s.chatter, products)       
                                                                                
         if err != nil {                                                        
                                                                                
             log.Printf("recipe creative: products=%v: %v", products, err)      
                                                                                
             writeError(w, http.StatusBadGateway, "генерация не удалась,        
 попробуй ещё раз")                                                             
                                                                                
             return                                                             
                                                                                
         }                                                                      
                                                                                
         writeJSON(w, http.StatusOK, recipeResponse{Mode: mode, Invented: true, 
 Text: text})                                                                   
                                                                                
                                                                                
                                                                                
     case "strict", "combine":                                                  
                                                                                
         rec, err := s.corpus.Get(req.RecipeID)                                 
                                                                                
         if errors.Is(err, corpus.ErrNotFound) {                                
                                                                                
             writeError(w, http.StatusNotFound, "рецепт не найден:              
 "+req.RecipeID)                                                                
                                                                                
             return                                                             
                                                                                
         }                                                                      
                                                                                
         if err != nil {                                                        
                                                                                
             log.Printf("recipe: corpus.Get(%s): %v", req.RecipeID, err)        
                                                                                
             writeError(w, http.StatusInternalServerError, "внутренняя ошибка") 
                                                                                
             return                                                             
                                                                                
         }                                                                      
                                                                                
         resp := recipeResponse{Mode: mode, Title: rec.Title, Source:           
 &rec.Source}                                                                   
                                                                                
         if mode == "strict" {                                                  
                                                                                
             resp.Text = generate.Strict(rec)                                   
                                                                                
             writeJSON(w, http.StatusOK, resp)                                  
                                                                                
             return                                                             
                                                                                
         }                                                                      
                                                                                
         if len(products) == 0 {                                                
                                                                                
             writeError(w, http.StatusBadRequest, "для combine нужны продукты") 
                                                                                
             return                                                             
                                                                                
         }                                                                      
                                                                                
         text, err := generate.Combine(r.Context(), s.chatter, rec, products)   
                                                                                
         if err != nil {                                                        
                                                                                
             log.Printf("recipe combine: id=%s products=%v: %v", rec.ID,        
 products, err)                                                                 
                                                                                
             writeError(w, http.StatusBadGateway, "генерация не удалась,        
 попробуй ещё раз")                                                             
                                                                                
             return                                                             
                                                                                
         }                                                                      
                                                                                
         resp.Text = text                                                       
                                                                                
         writeJSON(w, http.StatusOK, resp)                                      
                                                                                
                                                                                
                                                                                
     default:                                                                   
                                                                                
         writeError(w, http.StatusBadRequest, "mode должен быть strict, combine 
 или creative")                                                                 
                                                                                
     }                                                                          
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 // normalize канонизирует имена продуктов и выкидывает пустые и дубли.         
                                                                                
 func normalize(c *corpus.Corpus, products []string) []string {                 
                                                                                
     seen := make(map[string]bool)                                              
                                                                                
     out := make([]string, 0, len(products))                                    
                                                                                
     for _, p := range products {                                               
                                                                                
         if strings.TrimSpace(p) == "" {                                        
                                                                                
             continue                                                           
                                                                                
         }                                                                      
                                                                                
         name := c.Canon(p)                                                     
                                                                                
         if !seen[name] {                                                       
                                                                                
             seen[name] = true                                                  
                                                                                
             out = append(out, name)                                            
                                                                                
         }                                                                      
                                                                                
     }                                                                          
                                                                                
     return out                                                                 
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 // decode разбирает JSON-тело; false — ответ с ошибкой уже отправлен.          
                                                                                
 func decode(w http.ResponseWriter, r *http.Request, dst any) bool {            
                                                                                
     if err := json.NewDecoder(http.MaxBytesReader(w, r.Body,                   
 1<<20)).Decode(dst); err != nil {                                              
                                                                                
         writeError(w, http.StatusBadRequest, "некорректный JSON в теле         
 запроса")                                                                      
                                                                                
         return false                                                           
                                                                                
     }                                                                          
                                                                                
     return true                                                                
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 func writeJSON(w http.ResponseWriter, status int, v any) {                     
                                                                                
     w.Header().Set("Content-Type", "application/json; charset=utf-8")          
                                                                                
     w.WriteHeader(status)                                                      
                                                                                
     if err := json.NewEncoder(w).Encode(v); err != nil {                       
                                                                                
         log.Printf("api: запись ответа: %v", err)                              
                                                                                
     }                                                                          
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 func writeError(w http.ResponseWriter, status int, msg string) {               
                                                                                
     writeJSON(w, status, map[string]string{"error": msg})                      
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 // handleFeedback обрабатывает обратную связь пользователя по готовому         
 рецепту.                                                                       
                                                                                
 func (s *Server) handleFeedback(w http.ResponseWriter, r *http.Request) {      
                                                                                
     var req feedbackRequest                                                    
                                                                                
     if !decode(w, r, &req) {                                                   
                                                                                
         return                                                                 
                                                                                
     }                                                                          
                                                                                
     if req.Rating < 1 || req.Rating > 5 {                                      
                                                                                
         writeError(w, http.StatusBadRequest, "rating должен быть в диапазоне   
 1..5")                                                                         
                                                                                
         return                                                                 
                                                                                
     }                                                                          
                                                                                
                                                                                
                                                                                
     now := time.Now().Format(time.RFC3339)                                     
                                                                                
     feedbackPath := os.Getenv("FEEDBACK_PATH")                                 
                                                                                
     if feedbackPath == "" {                                                    
                                                                                
         feedbackPath = "./feedback.jsonl"                                      
                                                                                
     }                                                                          
                                                                                
     data, err := json.Marshal(map[string]interface{}{                          
                                                                                
         "recipe_id": req.RecipeID,                                             
                                                                                
         "rating":    req.Rating,                                               
                                                                                
         "comment":   req.Comment,                                              
                                                                                
         "time":      now,                                                      
                                                                                
     })                                                                         
                                                                                
     if err != nil {                                                            
                                                                                
         writeError(w, http.StatusInternalServerError, "ошибка при формировании 
 JSON")                                                                         
                                                                                
         return                                                                 
                                                                                
     }                                                                          
                                                                                
     data = append(data, '\n')                                                  
                                                                                
                                                                                
                                                                                
     f, err := os.OpenFile(feedbackPath, os.O_APPEND|os.O_CREATE|os.O_WRONLY,   
 0o644)                                                                         
                                                                                
     if err != nil {                                                            
                                                                                
         writeError(w, http.StatusInternalServerError, "ошибка открытия файла   
 для записи")                                                                   
                                                                                
         return                                                                 
                                                                                
     }                                                                          
                                                                                
     defer f.Close()                                                            
                                                                                
                                                                                
                                                                                
     if _, err := f.Write(data); err != nil {                                   
                                                                                
         writeError(w, http.StatusInternalServerError, "ошибка записи в файл")  
                                                                                
         return                                                                 
                                                                                
     }                                                                          
                                                                                
                                                                                
                                                                                
     writeJSON(w, http.StatusCreated, map[string]string{"status": "ok"})        
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 type feedbackRequest struct {                                                  
                                                                                
     RecipeID string `json:"recipe_id,omitempty"`                               
                                                                                
     Rating   int    `json:"rating"`                                            
                                                                                
     Comment  string `json:"comment,omitempty"`                                 
                                                                                
 }                                                                              
                                                                                

