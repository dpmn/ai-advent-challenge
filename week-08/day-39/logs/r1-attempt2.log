     reply string                                                               
                                                                                
     err   error                                                                
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
 func (f *fakeChatter) Chat(context.Context, string, string) (string, error) {  
                                                                                
     return f.reply, f.err                                                      
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
