 func TestRecipeErrors(t *testing.T) {                                          
                                                                                
     tests := []struct {                                                        
                                                                                
         name, body string                                                      
                                                                                
         chatter    *fakeChatter                                                
                                                                                
         wantCode   int                                                         
                                                                                
     }{                                                                         
                                                                                
         {"неизвестный id", `{"recipe_id":"нет","mode":"strict"}`,              
 &fakeChatter{}, 404},                                                          
                                                                                
         {"неизвестный mode", `{"recipe_id":"r1","mode":"жарь"}`,               
 &fakeChatter{}, 400},                                                          
                                                                                
         {"combine без продуктов", `{"recipe_id":"r1","mode":"combine"}`,       
 &fakeChatter{}, 400},                                                          
                                                                                
         {"creative без продуктов", `{"mode":"creative"}`, &fakeChatter{},      
 400},                                                                          
                                                                                
         {"ошибка LLM",                                                         
 `{"recipe_id":"r1","products":["творог"],"mode":"combine"}`,                   
                                                                                
             &fakeChatter{err: errors.New("boom")}, 502},                       
                                                                                
     }                                                                          
                                                                                
     for _, tc := range tests {                                                 
                                                                                
         t.Run(tc.name, func(t *testing.T) {                                    
                                                                                
             srv := newTestServer(t, tc.chatter)                                
                                                                                
             var e map[string]string                                            
                                                                                
             if code := post(t, srv, "/api/v1/recipe", tc.body, &e); code !=    
 tc.wantCode {                                                                  
                                                                                
                 t.Fatalf("статус %d, ожидался %d (%v)", code, tc.wantCode, e)  
                                                                                
             }                                                                  
                                                                                
         })                                                                     
                                                                                
     }                                                                          
                                                                                
 }                                                                              
                                                                                
                                                                                
                                                                                
