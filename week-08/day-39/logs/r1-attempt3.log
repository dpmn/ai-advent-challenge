 +// handleFeedback обрабатывает обратную связь пользователя.                   
 +func (s *Server) handleFeedback(w http.ResponseWriter, r *http.Request) {     
 +   var req struct {                                                           
 +       RecipeID string `json:"recipe_id,omitempty"`                           
 +       Rating   int    `json:"rating"`                                        
 +       Comment  string `json:"comment,omitempty"`                             
 +   }                                                                          
 +   if !decode(w, r, &req) {                                                   
 +       return                                                                 
 +   }                                                                          
 +                                                                              
 +   if req.Rating < 1 || req.Rating > 5 {                                      
 +       writeError(w, http.StatusBadRequest, "рейтинг должен быть в диапазоне  
 1..5")                                                                         
 +       return                                                                 
 +   }                                                                          
 +                                                                              
 +   if len(req.Comment) > 1000 {                                               
 +       writeError(w, http.StatusBadRequest, "комментарий не может превышать   
 1000 символов")                                                                
 +       return                                                                 
 +   }                                                                          
 +                                                                              
 +   path := os.Getenv("FEEDBACK_PATH")                                         
 +   if path == "" {                                                            
 +       path = "./feedback.jsonl"                                              
 +   }                                                                          
 +                                                                              
 +   timestamp := time.Now().UTC().Format(time.RFC3339)                         
 +   entry, err := json.Marshal(map[string]interface{}{                         
 +       "recipe_id": req.RecipeID,                                             
 +       "rating":    req.Rating,                                               
 +       "comment":   req.Comment,                                              
 +       "timestamp": timestamp,                                                
 +   })                                                                         
 +   if err != nil {                                                            
 +       writeError(w, http.StatusInternalServerError, "ошибка при формировании 
 записи")                                                                       
 +       return                                                                 
 +   }                                                                          
 +                                                                              
 +   file, err := os.OpenFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644) 
 +   if err != nil {                                                            
 +       writeError(w, http.StatusInternalServerError, "ошибка открытия файла   
 для записи")                                                                   
 +       return                                                                 
 +   }                                                                          
 +   defer file.Close()                                                         
 +                                                                              
 +   if _, err := file.Write(entry); err != nil {                               
 +       writeError(w, http.StatusInternalServerError, "ошибка записи в файл")  
 +       return                                                                 
 +   }                                                                          
 +                                                                              
 +   writeJSON(w, http.StatusCreated, map[string]string{"status": "ok"})        
 +}                                                                             
                                                                                

